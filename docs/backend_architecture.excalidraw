      "opacity": 100,
      "originalText": "KEY ARCHITECTURAL HIGHLIGHTS & CONNECTIVITY PATTERNS",
      "roughness": 1,
      "roundness": null,
      "seed": 1110091324,
      "strokeColor": "#1e1e1e",
      "strokeStyle": "solid",
